{
  "expo": {
    "name": "MutaCare",
    "slug": "fe-mutacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "femutacare",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mutacare.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "AUDIO_SETTINGS",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8ee355e-d6db-4def-bc65-9468f12b4975"
      }
    },
    "owner": "mutacare"
  }
}
