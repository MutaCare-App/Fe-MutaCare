{
  "expo": {
    "name": "mutacare",
    "slug": "fe-mutacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "femutacare",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
