{
  "expo": {
    "name": "MutaCare",
    "slug": "fe-mutacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "scheme": "femutacare",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mutacare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/icon.png",
        "backgroundColor": "#516D47"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "AUDIO_SETTINGS",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/logo/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#516D47"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8ee355e-d6db-4def-bc65-9468f12b4975"
      }
    },
    "owner": "mutacare"
  }
}
